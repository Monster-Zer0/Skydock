{
  "multipart": [
    { "apply": { "model": "skydock:block/timber_railing_post" } },
    { "when": { "north": "true" }, "apply": { "model": "skydock:block/timber_railing_side" } },
    { "when": { "east": "true" }, "apply": { "model": "skydock:block/timber_railing_side", "y": 90, "uvlock": true } },
    { "when": { "south": "true" }, "apply": { "model": "skydock:block/timber_railing_side", "y": 180, "uvlock": true } },
    { "when": { "west": "true" }, "apply": { "model": "skydock:block/timber_railing_side", "y": 270, "uvlock": true } }
  ]
}
